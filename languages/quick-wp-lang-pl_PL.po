#. Description of the plugin
#: quick-wp-lang.php
msgid "Set the language of individual posts, pages and custom post types for SEO, and link translations to their original, without a full multilingual setup."
msgstr "Set the language of individual posts, pages and custom post types for SEO, and link translations to their original, without a full multilingual setup."

#: includes/class-admin-hooks.php:29
msgctxt "meta box title"
msgid "Content Language"
msgstr "Język treści"

#: includes/class-admin-hooks.php:62
msgctxt "language choice"
msgid "Site default"
msgstr "Domyślne ustawienie strony"

#: includes/class-admin-hooks.php:83
msgid "Configure available languages"
msgstr "Skonfiguruj dostępne języki"

#: includes/class-admin-hooks.php:113
msgctxt "meta box field label; the original this content translates"
msgid "Translation of"
msgstr "Tłumaczenie"

#: includes/class-admin-hooks.php:119
msgctxt "no original selected"
msgid "— Not linked —"
msgstr "— Brak linku —"

#. translators: %s: Name of the site's language, e.g. "English (UK)".
#: includes/class-admin-hooks.php:138
#, php-format
msgid "The %s version of this content. Both pages then list each other in their hreflang tags, so search engines show visitors the right one."
msgstr "Wersja tej treści oznaczona jako %s. Obie strony zawierają wzajemne odniesienia w tagach hreflang, dzięki czemu wyszukiwarki wyświetlają odwiedzającym właściwą stronę."

#: includes/class-admin-hooks.php:161
msgctxt "meta box heading; list of linked translations"
msgid "Translations"
msgstr "Tłumaczenia"

#: includes/class-admin-hooks.php:183
msgid "(not used: an older translation already covers this language)"
msgstr "(nie wykorzystano: ten język został już uwzględniony w starszym tłumaczeniu)"

#. translators: 1: Post title, 2: Post ID.
#: includes/class-admin-hooks.php:238
#, php-format
msgid "%1$s (#%2$d)"
msgstr "%1$s (#%2$d)"

#: includes/class-admin-hooks.php:239
msgid "(no title)"
msgstr "(bez tytułu)"

#: includes/class-admin-hooks.php:321
msgid "Configure your languages to get started"
msgstr "Skonfiguruj języki, aby rozpocząć pracę"

#: includes/class-admin-hooks.php:387
#: includes/class-admin-hooks.php:395
msgctxt "list table column heading"
msgid "Language"
msgstr "Język"

#: includes/class-plugin.php:124
msgctxt "plugin action link"
msgid "Settings"
msgstr "Ustawienia"

#: includes/class-settings.php:39
msgctxt "admin menu label"
msgid "Content Language"
msgstr "Język treści"

#: includes/class-settings.php:115
msgid "Content-Language Header"
msgstr "Nagłówek „Treść – Język”"

#: includes/class-settings.php:123
#: includes/class-settings.php:308
msgid "Enable for Post Types"
msgstr "Włącz dla typów wpisów"

#: includes/class-settings.php:139
msgctxt "settings section heading"
msgid "Uninstall"
msgstr "Odinstaluj"

#: includes/class-settings.php:146
msgid "Plugin data"
msgstr "Wtyczka danych"

#: includes/class-settings.php:168
msgid "Delete all plugin data when uninstalled"
msgstr "Usuń wszystkie dane wtyczki po jej odinstalowaniu"

#: includes/class-settings.php:173
msgid "When ticked, deleting the plugin from the Plugins screen removes its settings and every language and translation link set on your content. Deactivating never deletes anything."
msgstr "Jeśli to pole jest zaznaczone, usunięcie wtyczki z ekranu „Wtyczki” spowoduje usunięcie jej ustawień oraz wszystkich linków do języków i tłumaczeń ustawionych w treściach. Dezaktywacja nigdy niczego nie usuwa."

#: includes/class-settings.php:227
msgid "Search languages by name or code..."
msgstr "Wyszukaj języki według nazwy lub kodu..."

#: includes/class-settings.php:228
msgctxt "button label; empties the search box"
msgid "Clear"
msgstr "Wyczyść"

#. translators: 1: Number of enabled languages, 2: Total number of available languages.
#: includes/class-settings.php:236
#, php-format
msgid "%1$d of %2$d language enabled"
msgid_plural "%1$d of %2$d languages enabled"
msgstr[0] "Włączono %1$d z %2$d języków"
msgstr[1] "%1$d z %2$d języków włączono"
msgstr[2] "%1$d of %2$d languages enabled"

#: includes/class-settings.php:251
msgid "(site default language)"
msgstr "(domyślny język strony)"

#: includes/class-settings.php:289
msgid "Send Content-Language HTTP header for posts with alternative languages"
msgstr "Wysyłaj nagłówek HTTP „Content-Language” dla wpisów w alternatywnych językach"

#: includes/class-settings.php:294
msgid "When enabled, the plugin will send a Content-Language HTTP header for posts/pages with an assigned language. This helps search engines and browsers identify the content language."
msgstr "Po włączeniu wtyczka będzie wysyłać nagłówek HTTP „Content-Language” dla wpisów i stron, którym przypisano język. Pomaga to wyszukiwarkom i przeglądarkom w rozpoznaniu języka treści."

#: includes/class-settings.php:330
msgid "Select which post types show the language box in the editor and the Language column in the list of posts. Untick them all to hide both everywhere."
msgstr "Wybierz typy wpisów, dla których w edytorze ma być wyświetlane okienko wyboru języka, a na liście wpisów – kolumna „Język”. Odznacz wszystkie opcje, aby ukryć oba elementy we wszystkich miejscach."
