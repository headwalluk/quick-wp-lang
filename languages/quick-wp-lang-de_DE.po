#. translators: %s: Name of the site's language, e.g. "English (UK)".
#: includes/class-admin-hooks.php:138
#, php-format
msgid "The %s version of this content. Both pages then list each other in their hreflang tags, so search engines show visitors the right one."
msgstr "Die %s-Version dieses Inhalts. Beide Seiten verweisen dann in ihren hreflang-Tags aufeinander, sodass Suchmaschinen den Besuchern die richtige Seite anzeigen."

#: includes/class-admin-hooks.php:161
msgctxt "meta box heading; list of linked translations"
msgid "Translations"
msgstr "Übersetzungen"

#: includes/class-admin-hooks.php:183
