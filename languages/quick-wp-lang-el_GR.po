msgctxt "no original selected"
msgid "— Not linked —"
msgstr "— Χωρίς σύνδεσμο —"

#. translators: %s: Name of the site's language, e.g. "English (UK)".
#: includes/class-admin-hooks.php:138
#, php-format
msgid "The %s version of this content. Both pages then list each other in their hreflang tags, so search engines show visitors the right one."
msgstr "Η έκδοση %s αυτού του περιεχομένου. Στη συνέχεια, οι δύο σελίδες αναφέρουν η μία την άλλη στις ετικέτες hreflang τους, ώστε οι μηχανές αναζήτησης να εμφανίζουν στους επισκέπτες τη σωστή σελίδα."

#: includes/class-admin-hooks.php:161
msgctxt "meta box heading; list of linked translations"
msgid "Translations"
msgstr "Μεταφράσεις"

#: includes/class-admin-hooks.php:183
msgid "(not used: an older translation already covers this language)"
msgstr "(δεν χρησιμοποιείται: υπάρχει ήδη μια παλαιότερη μετάφραση για αυτή τη γλώσσα)"

#. translators: 1: Post title, 2: Post ID.
#: includes/class-admin-hooks.php:238
#, php-format
