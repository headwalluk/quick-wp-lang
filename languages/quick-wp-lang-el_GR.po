#. Plugin Name of the plugin
#: quick-wp-lang.php
msgid "Quick WP Lang"
msgstr "Quick WP Lang"

#: includes/class-admin-hooks.php:52
msgid "Select the language for this content:"
msgstr "Επιλέξτε τη γλώσσα για αυτό το περιεχόμενο:"

#: includes/class-admin-hooks.php:88
msgid "If this content is written in a language other than the site default, select it here. This will update the page's language attributes and hreflang tags for better SEO."
msgstr "Εάν αυτό το περιεχόμενο είναι γραμμένο σε γλώσσα διαφορετική από την προεπιλεγμένη γλώσσα του ιστότοπου, επιλέξτε την εδώ. Αυτό θα ενημερώσει τα χαρακτηριστικά γλώσσας της σελίδας και τις ετικέτες hreflang για καλύτερη SEO."

#: includes/class-admin-hooks.php:319
msgid "No languages are enabled yet."
msgstr "Δεν έχουν ενεργοποιηθεί ακόμη γλώσσες."

#: includes/class-settings.php:38
msgid "Content Language Settings"
msgstr "Ρυθμίσεις γλώσσας περιεχομένου"

#: includes/class-settings.php:108
msgid "Available Languages"
msgstr "Διαθέσιμες γλώσσες"

#: includes/class-settings.php:131
#: includes/class-settings.php:244
msgid "Enable Languages"
msgstr "Ενεργοποίηση γλωσσών"

#: includes/class-settings.php:184
msgid "You do not have permission to access this page."
msgstr "Δεν έχετε άδεια πρόσβασης σε αυτή τη σελίδα."

#: includes/class-settings.php:207
msgid "Select the languages you want to make available for content assignment. These will appear as options in post/page editor sidebars."
msgstr "Επιλέξτε τις γλώσσες που θέλετε να είναι διαθέσιμες για την ανάθεση περιεχομένου. Αυτές θα εμφανίζονται ως επιλογές στις πλευρικές στήλες του επεξεργαστή δημοσιεύσεων/σελίδων."

#: includes/class-settings.php:273
msgid "Select at least one language to enable language selection in your posts and pages."
msgstr "Επιλέξτε τουλάχιστον μία γλώσσα για να ενεργοποιήσετε την επιλογή γλώσσας στις αναρτήσεις και τις σελίδες σας."

