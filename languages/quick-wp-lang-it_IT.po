msgid "— Not linked —"
msgstr "— Nessun collegamento —"

#. translators: %s: Name of the site's language, e.g. "English (UK)".
#: includes/class-admin-hooks.php:138
#, php-format
msgid "The %s version of this content. Both pages then list each other in their hreflang tags, so search engines show visitors the right one."
msgstr "La versione %s di questo contenuto. Entrambe le pagine si indicano a vicenda nei propri tag hreflang, in modo che i motori di ricerca mostrino ai visitatori quella corretta."

#: includes/class-admin-hooks.php:161
msgctxt "meta box heading; list of linked translations"
msgid "Translations"
msgstr "Traduzioni"

#: includes/class-admin-hooks.php:183
msgid "(not used: an older translation already covers this language)"
msgstr "(non utilizzato: questa lingua è già trattata in una traduzione precedente)"

